# ── Zermitt environment ────────────────────────────────────────────────
# Copy to .env. DEMO_MODE=true works with NO other variables set
# (dry Intents quotes + mocked login). Spike 3 and later phases need a
# funded testnet relayer account.

# Demo mode: testnet, mocked Google login, test relayer for gas. Default: true.
DEMO_MODE=true

# NEAR network (only read when DEMO_MODE=false). testnet | mainnet
NEAR_NETWORK=testnet

# Optional RPC override. Default: https://rpc.<network>.near.org
# NEAR_NODE_URL=

# Testnet account that funds claim links and pays gas for meta-transactions.
# Get one: https://testnet.mynearwallet.com (create account), then export the
# key, or use near-cli-rs: `near account create-account sponsor-by-faucet-service`
RELAYER_ACCOUNT_ID=
# Full-access private key for the relayer (ed25519:...). NEVER commit this.
RELAYER_PRIVATE_KEY=

# Allow the mocked Google login path (judges need no real accounts). Default: true in demo mode.
MOCK_LOGIN=true

# Privy App ID for the real Google login (Phase 2). Free at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: Anthropic API key for LLM intent parsing. Without it, demo mode
# uses a deterministic fallback parser (judges need no key).
# ANTHROPIC_API_KEY=

# NEP-141 test stablecoin paid out to claimed accounts on testnet.
TEST_USDC_CONTRACT=usdc.fakes.testnet

# Receipts contracts (deployed; reads are keyless). v2 adds optional TEE fields.
RECEIPTS_CONTRACT=receipts-v2.zermitt.testnet
RECEIPTS_CONTRACT_V1=receipts.zermitt.testnet

# ── Private agent (NEAR AI Cloud) — optional ───────────────────────────
# AGENT_PROVIDER: nearai | anthropic | fallback.
# Defaults: nearai if NEARAI_API_KEY is set, else anthropic if set, else fallback.
# AGENT_PROVIDER=
# API key from https://cloud.near.ai (TEE-hosted inference + attestation).
# NEARAI_API_KEY=
# Default: cheapest attestation-capable model per parse (TDX + NVIDIA evidence).
# NEARAI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# ── LIVE_INTENTS (off by default) ──────────────────────────────────────
# true runs a REAL small mainnet swap via 1Click (max 2 USDT) for the one
# recorded proof transaction. Needs a funded mainnet account.
LIVE_INTENTS=false
# MAINNET_ACCOUNT_ID=
# MAINNET_PRIVATE_KEY=

# Optional 1Click (NEAR Intents) JWT — lowers fees; dry quotes work without it.
# Request: https://docs.near-intents.org/integration/distribution-channels/1click-api/authentication
ONECLICK_JWT=
